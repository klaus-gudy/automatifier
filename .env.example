NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_ENABLED=

# Logs full request bodies to the terminal. Off unless "true" — a body is the
# likeliest place for something that should not be in a log, and the redaction
# in log-format.ts only catches keys whose names it knows.
LOG_REQUEST_BODY=

# --- Postgres -----------------------------------------------------------
# Either set DATABASE_URL on its own, or the discrete fields below it.
# When DATABASE_URL is set it wins and the others are ignored.
# DATABASE_URL=postgres://postgres:postgres@localhost:5440/automatifier
DATABASE_HOST=localhost
DATABASE_PORT=5440
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=automatifier

# Runs pending migrations at boot. Fine for a single process; set to "false"
# and run `npm run migration:run` as a deploy step once this has replicas,
# or two instances starting together will race on the same migration.
DATABASE_MIGRATIONS_RUN=
# Verbatim SQL in the terminal. "true" to enable.
DATABASE_LOGGING=

# --- RabbitMQ -----------------------------------------------------------
# "false" skips the broker connection entirely, so the HTTP side can be run
# without a RabbitMQ on the machine.
RABBITMQ_ENABLED=
RABBITMQ_URL=amqp://guest:guest@localhost:5683

# The topic exchange everything is published to. The dead-letter exchange is
# derived as <value>.dlx — it is not configured separately, so the pair cannot
# drift apart.
EVENT_EXCHANGE=automatifier.events

# This service's own mailbox on the broker. Deliberately in caps so it is never
# mistaken for a routing key — a queue is *who consumes*, a routing key is
# *what happened*. Each listener's dead-letter queue is derived as <queue>_DEAD.
EVENT_QUEUE=AUTOMATIFIER_QUEUE

# How many unacked messages the broker may have in flight to this process.
RABBITMQ_PREFETCH=10
